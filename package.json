{
  "name": "pi-agent-plugins",
  "version": "0.1.0",
  "description": "Agent Plugins package loader for pi",
  "keywords": [
    "agent-plugins",
    "pi-package"
  ],
  "license": "MIT",
  "author": "Mike Wallio",
  "type": "module",
  "scripts": {
    "build": "tsgo -p ./tsconfig.json",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint -c .oxlintrc.json --tsconfig ./tsconfig.json src/*.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@earendil-works/pi-coding-agent": "1.0.0",
    "@oxlint/plugins": "1.86.0",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "oxfmt": "^0.71.0",
    "oxlint": "1.86.0",
    "oxlint-tsgolint": "7.0.2003",
    "typebox": "^1.3.34",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.99.1",
    "typebox": "*"
  },
  "pi": {
    "extensions": [
      "./src/index.ts"
    ]
  }
}
